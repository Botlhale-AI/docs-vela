# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docusaurus build output
build/
.docusaurus/

# Build output that was previously committed to the repository root. `docusaurus
# build` writes the rendered site into build/, but an earlier deploy left a copy
# at the root: rendered .html for every route, the content-hashed assets/ bundle,
# the generated feeds, and sitemap.xml. They went stale silently — the last set
# was Docusaurus v3.1.1 output advertising routes that no longer exist — so they
# are ignored here rather than tracked.
#
# Note img/ is NOT build output. The documentation screenshots live in
# img/screenshots/ and are referenced by relative path from the .md files.
/*.html
/blog/**/*.html
/markdown-page/
/assets/
/sitemap.xml
/blog/atom.xml
/blog/rss.xml
/favicon.ico

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE and editor files
.vscode/
.idea/
.claude/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# Temporary folders
tmp/
temp/

# Crash artefacts
*.stackdump

# Single lockfile: this repo uses npm and package-lock.json
yarn.lock
